# Drift — 环境变量清单
#
# 本文件只列**键与说明**，不含任何真实值。真实值写在 .env（.gitignore 已排除 .env*）。
# apps/api 在启动时用 zod 一次性校验这些变量（apps/api/src/config/env.ts），
# 任何一项缺失或格式错误都会让进程 exit 1 —— 起不来是可见的，半年后才发现不是。

# ── apps/api ────────────────────────────────────────────────────────────────
# 唯一的 PostgreSQL。同库承载 OLTP + pgvector 向量检索 + pg-boss 任务队列（PLAT-02）。
# docker compose 内部形如 postgres://drift:<password>@postgres:5432/drift
DATABASE_URL=

# apps/api 的 HTTP + WebSocket 端口。Docker healthcheck 打这个端口的 /healthz。
PORT=3001

# apps/web 的 origin，CORS 白名单的唯一来源。不接受 '*'。
WEB_ORIGIN=

# pino 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 企业微信机器人 webhook。危机二级的运营者会话外通知（SAFE-04 / D-09）走它。
# Plan 06 的 notifyOperator 与 Plan 07 的状态机使用；本 plan 只声明。
WECOM_WEBHOOK_URL=

# 运营者后台共享密钥（D-09/D-10 的 /internal/contact-attempts/* 两个端点）。
# 必填、至少 32 字符、无默认值 —— 它与用户 session 是两条不相交的认证路径；把运营者
# 动作挂在用户 session 上意味着任何用户都能把别人的联络尝试标成 delivered，而
# delivered 会让界面陈述「我们已经联系了」。生成：openssl rand -hex 32
OPERATOR_API_TOKEN=

# better-auth 的签名密钥（D-22）。必填、至少 32 字符、无默认值。
# better-auth 在缺省时会自己生成一个进程内密钥并只打一条 warning —— 那意味着每次
# 重启后全部已签发会话静默失效，现象是「用户莫名其妙被登出」而不是一条错误。
# 生成：openssl rand -hex 32
BETTER_AUTH_SECRET=

# 紧急联系人联系方式的 AES-256-GCM 密钥，**64 个十六进制字符**（32 字节）。
# 必填、无默认值、**不提供明文回退**：联系方式是第三方的个人信息，用户本人并未代其
# 同意展示。一个「密钥没配就先存明文」的分支会让库里躺着一批明文号码，而读路径对两种
# 形态都能工作，所以没有任何检查会发现它。
# ⚠️ 轮换这个密钥会让已存的 contact_ref_encrypted 全部解不开（危机流程会退到
# unavailable 并如实告知用户）。轮换前必须先做一次重加密迁移。
# 生成：openssl rand -hex 32
CONTACT_ENCRYPTION_KEY=

# LLM 通道模式：mock = 不出网的假 provider（D-27）；live = 真实调用。默认 mock。
# ⚠️ LLM API key 只存在于境内本机（D-02），不进 GitHub Secrets、不进本文件。
LLM_PROVIDER_MODE=mock

# ── 模型服务配置（可选，接入自有模型代理 / 云厂商兼容端点）────────────────────
# llm.config.json 的路径。模板见仓库根的 llm.config.example.json（复制后改）。
# 未设置 = 全部走内置路由表（routes.ts 的厂商直连登记：火山方舟 + 智谱）。
# 设置后：启动时一次性读入并校验，格式错误进程起不来（packages/llm/src/config.ts）。
# 配置里每个 provider 声明 apiKeyEnv（key 的环境变量名，key 本体不进配置文件），
# 下方 LOCAL_PROXY_API_KEY 就是一个例子 —— 按你的 provider 名改成对应变量。
# docker compose 场景：宿主路径经 LLM_ROUTES_CONFIG_FILE 挂载为容器内
# /etc/drift/llm.config.json，容器内访问宿主代理用 host.docker.internal（Linux 下
# compose 已配 extra_hosts 映射）。本机直跑（node apps/api）用 127.0.0.1。
LLM_ROUTES_CONFIG=
LLM_ROUTES_CONFIG_FILE=./llm.config.json
LOCAL_PROXY_API_KEY=

# ── docker compose ─────────────────────────────────────────────────────────
# postgres 服务的初始化凭据。与 DATABASE_URL 必须一致。
POSTGRES_USER=drift
POSTGRES_PASSWORD=
POSTGRES_DB=drift

# api / web 容器端口在宿主上的绑定地址。**默认仅回环**：本阶段的库里有敏感个人
# 信息，监听所有网卡等于把未加固的开发态服务暴露到局域网。需要从别的机器访问时
# （例如人工试玩走查）才显式放开，例如 API_BIND=0.0.0.0 WEB_BIND=0.0.0.0，
# 且不要把放开后的值提交进仓库。对外正式入口是 caddy 的 SITE_ADDRESS，不是这两项。
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# caddy 对外提供的站点地址。生产必须是已做非经营性 ICP 备案的域名（D-04）——
# 境内云厂商对未备案域名封 80/443。本地开发用 localhost，Caddy 签发内部证书。
SITE_ADDRESS=localhost

# ── apps/web ───────────────────────────────────────────────────────────────
# 浏览器侧可见的 apps/api 地址（REST + WS 同源反代后通常留空即可）。
NEXT_PUBLIC_API_ORIGIN=
