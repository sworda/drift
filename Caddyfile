# TLS 终止与反代。生产域名必须已做非经营性 ICP 备案（D-04）——
# 境内云厂商对未备案域名直接封 80/443，Caddy 的自动 HTTPS 也就拿不到证书。
#
# SITE_ADDRESS=localhost 时 Caddy 用内部 CA 签发证书，不去 ACME（本地开发）。

{
	# 这里**故意没有** `email` 全局指令：它不接受空值，而 {$ACME_EMAIL} 在未设置
	# 时展开为空串会让整个配置解析失败（`wrong argument count ... after 'email'`,
	# 本 plan 内实测）。给它一个假的默认地址比不设更糟 —— 那会拿一个收不到信的
	# 邮箱去注册 ACME 账户，证书到期通知就永远没人看到。
	# 生产上要 ACME 通知时，在这里显式写上真实邮箱。
	# admin API 只听回环，是 compose healthcheck 的探针来源。
	admin 127.0.0.1:2019
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# 访问日志从设计上不含个人信息，成立条件有两条（缺一即失守）：
	#   1. 不记请求体 —— Caddy 默认不记录 body，这条无需配置；
	#   2. query 里的凭证键（token / conversationId）在写日志前被 filter 删除。
	#      /ws?conversationId=&token=（session token）与 /privacy-receipts/:id?token=
	#      （一次性回执凭证）都会把凭证写进一个不能按行删除的存储位置（容器 stdout），
	#      一键删除（PRIV-05）级联不到它。这与 apps/api 的 pino 白名单是同一条约束。
	#      ⚠️ 新增任何「query 传凭证」的路径，必须同步在这里加 delete，注释即契约。
	log {
		output stdout
		format filter {
			wrap console
			request>uri query {
				# 凭证与渠道标识在写日志前从 query 里删除（脱敏 URI）。
				# token：/ws 的 session token 与 /privacy-receipts 的一次性回执凭证。
				# conversationId：acute 告警载荷外流的渠道（01-REVIEW #1）。
				delete token
				delete conversationId
			}
		}
	}

	# apps/api 的三条对外路径。单条 WebSocket 承载全部实时语义（STACK §4），
	# 所以这里只需要放行 /ws 一个升级入口。
	@api path /healthz /ws /ws/* /telemetry/*
	handle @api {
		reverse_proxy api:3001
	}

	# 其余全部交给 apps/web。
	handle {
		reverse_proxy web:3000
	}
}
