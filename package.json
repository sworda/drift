{
  "name": "drift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --build tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 --no-cache",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract"
  },
  "devDependencies": {
    "@drift/contract": "workspace:*",
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
