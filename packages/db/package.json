{
  "name": "@drift/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check && node scripts/assert-no-drift.mjs",
    "db:seed": "node src/seed/run.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
